# MongoDB-Verbindung. Lokal in .env.local kopieren und den echten Wert eintragen.
# .env* ist per .gitignore ausgenommen, der Key landet also nicht im Repo.

# MongoDB Atlas:
MONGODB_URI="mongodb+srv://BENUTZER:PASSWORT@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Lokale MongoDB:
# MONGODB_URI="mongodb://localhost:27017"

# Optional — Standard ist "akquise-cockpit".
# MONGODB_DB="akquise-cockpit"

# Optional — nur für Entwicklung/Tests ohne Datenbank. Hält alle Daten im
# Arbeitsspeicher des Servers; beim Neustart sind sie weg.
# AKQ_STORE="memory"
